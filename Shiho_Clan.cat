              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">In the Starting Phase this model may choose not to generate Ki.
If it does so, remove any Impetuous Markers from it.</characteristic>
              </characteristics>
            </profile>
            <profile name="Lucky Rabbit" id="51ea-b736-4cd4-7c0f" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">This model begins the game with one Luck Token.
Whenever a Friendly model within 6&quot; of a model with a Luck Token makes a Fear Test, Attack Roll, Defence Roll, Damage Roll, or Opposed Ki Test, the model with the Luck Token may spend the Luck Token to re-roll one of the dice.</characteristic>
              </characteristics>
            </profile>
