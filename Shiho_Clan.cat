            <infoLink name="Defensive" id="d10b-466c-d9f1-05ae" hidden="false" targetId="c6e1-0904-b78f-7933" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Cub" id="5d13-0f56-786b-59f1" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">The Cub has separate Wound boxes to Kazuo. Mark Wound boxes as usual from left to right. You must mark Kazuo&apos;s Wound boxes first. This model&apos;s Last Stand trait triggers when either Kazuo&apos;s 6 Wound boxes or the Cub&apos;s 2 Wound boxes are all marked.</characteristic>
              </characteristics>
            </profile>
            <profile name="Ball or Sword" id="861f-223f-ba7d-c3ff" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">This model has the Aware and Defensive traits while the Cub has unmarked Wound boxes. You may choose to lose these traits in a Melee Exchange but, if you do, any Damage done to this model will be applied to the Cub&apos;s boxes instead of Kazuo&apos;s.</characteristic>
              </characteristics>
            </profile>
            <profile name="Frenzy" id="919a-5190-b9ff-c119" hidden="false" typeId="2f00-4eb0-a8cb-7022" typeName="Unique Effects">
              <characteristics>
                <characteristic name="Description" typeId="6de4-d067-c2aa-0dc2">When this model uses its Last Stand trait, it gains Activation Counters up to a maximum of 2 and all its Attacks are Critical Attacks in addition to any chosen Special Ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditionGroups>
