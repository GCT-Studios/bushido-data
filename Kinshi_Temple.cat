      <profiles>
        <profile name="Blessings of the Void" id="14fd-08fc-5a05-f7be" hidden="false" typeId="d2bb-86b4-edf3-c4e5" typeName="Special Card">
          <characteristics>
            <characteristic name="Description" typeId="b4b7-5338-e8e2-41fd">Some feats have a Rank listed in their cost column.
These Ki Feats may only be used if an effect allows them to be used at no cost.
Friendly Satsui models may use the following feats as if they were on their card:
- Whispers of the Void
- Silence of the Void</characteristic>
          </characteristics>
        </profile>
        <profile name="1" id="efbe-9c2e-ec6d-7cf0" hidden="false" typeId="1c8a-f738-1536-a08c" typeName="Escalation">
          <characteristics>
            <characteristic name="Required" typeId="f608-9700-ffa5-0c3f">1 Void Counter</characteristic>
            <characteristic name="Rank" typeId="84f7-58d8-a0a5-4d78">0</characteristic>
            <characteristic name="Card" typeId="d361-6342-4942-70a7">Blessings of the Void</characteristic>
            <characteristic name="Benefit" typeId="a962-35b8-ac0c-8018">When a Satsui &amp; Monk model is Killed, you may add 1 Void Counter to this Communal Card.</characteristic>
          </characteristics>
        </profile>
        <profile name="2" id="7826-81c9-c379-bde3" hidden="false" typeId="1c8a-f738-1536-a08c" typeName="Escalation">
          <characteristics>
            <characteristic name="Required" typeId="f608-9700-ffa5-0c3f">2 Void Counters</characteristic>
            <characteristic name="Rank" typeId="84f7-58d8-a0a5-4d78">0</characteristic>
            <characteristic name="Card" typeId="d361-6342-4942-70a7">Blessings of the Void</characteristic>
            <characteristic name="Benefit" typeId="a962-35b8-ac0c-8018">Satsui models entering BtB with a Void Rift may be placed in BtB with any other Void Rift by the Active Player and continue its movement (if any) from there.</characteristic>
          </characteristics>
        </profile>
        <profile name="3" id="3845-b894-16ba-beb0" hidden="false" typeId="1c8a-f738-1536-a08c" typeName="Escalation">
          <characteristics>
            <characteristic name="Required" typeId="f608-9700-ffa5-0c3f">3 Void Counters</characteristic>
            <characteristic name="Rank" typeId="84f7-58d8-a0a5-4d78">0</characteristic>
            <characteristic name="Card" typeId="d361-6342-4942-70a7">Blessings of the Void</characteristic>
            <characteristic name="Benefit" typeId="a962-35b8-ac0c-8018">When a Satsui &amp; Monk model performs a Focus Action, you may add 1 Void Counter to this Communal Card.</characteristic>
          </characteristics>
        </profile>
        <profile name="4" id="ba60-8b6f-bca8-479b" hidden="false" typeId="1c8a-f738-1536-a08c" typeName="Escalation">
